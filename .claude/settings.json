{
    "permissions": {
        "deny": [
            "Read(**/.env*)",
            "Read(**/env.php*)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/secrets/**)",
            "Read(**/credentials/**)",
            "Read(**/.aws/**)",
            "Read(**/.ssh/**)",
            "Read(**/docker-compose*.yml)",
            "Read(**/config/database.yml)"
        ]
    }
}